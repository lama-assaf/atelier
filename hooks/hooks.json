{
  "_comment": "STUDIO hooks template. ${STUDIO_ROOT} is replaced by the installer with the actual path. to use manually, replace ${STUDIO_ROOT} yourself and merge this into ~/.claude/settings.json under the hooks key.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${STUDIO_ROOT}/scripts/hooks/prompt-context.js"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${STUDIO_ROOT}/scripts/hooks/pre-write.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${STUDIO_ROOT}/scripts/hooks/post-write.js"
          }
        ]
      }
    ]
  }
}
